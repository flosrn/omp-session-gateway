{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/omp-session-gateway/session-list.schema.json",
  "title": "OMP Session Gateway metadata-only session list",
  "type": "object",
  "$defs": {
    "annotationText": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f\\u200e\\u200f\\u202a-\\u202e\\u2066-\\u2069]+$"
    },
    "nullableCount": {
      "anyOf": [
        { "type": "null" },
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      ]
    },
    "activity": {
      "description": "Last known activity. null is unknown, never zero; kept as last known on a stale machine.",
      "type": "object",
      "additionalProperties": false,
      "required": ["at", "tool", "intent", "preview", "contextTokens", "contextWindow", "cost", "subagents"],
      "properties": {
        "at": { "anyOf": [{ "type": "null" }, { "type": "integer", "minimum": 0, "maximum": 8640000000000000 }] },
        "tool": { "anyOf": [{ "type": "null" }, { "type": "string", "$ref": "#/$defs/annotationText", "maxLength": 64 }] },
        "intent": { "anyOf": [{ "type": "null" }, { "type": "string", "$ref": "#/$defs/annotationText", "maxLength": 160 }] },
        "preview": { "anyOf": [{ "type": "null" }, { "type": "string", "$ref": "#/$defs/annotationText", "maxLength": 240 }] },
        "contextTokens": { "$ref": "#/$defs/nullableCount" },
        "contextWindow": { "$ref": "#/$defs/nullableCount" },
        "cost": { "anyOf": [{ "type": "null" }, { "type": "number", "minimum": 0 }] },
        "subagents": { "$ref": "#/$defs/nullableCount" }
      }
    },
    "workspace": {
      "description": "Exactly matched Orca workspace. id and path identify it for actions and are never rendered.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "project", "branch", "comment", "status", "unread", "pr"],
      "properties": {
        "id": { "type": "string", "$ref": "#/$defs/annotationText", "maxLength": 1024 },
        "path": { "type": "string", "$ref": "#/$defs/annotationText", "maxLength": 512 },
        "project": { "type": "string", "$ref": "#/$defs/annotationText", "maxLength": 128 },
        "branch": { "anyOf": [{ "type": "null" }, { "type": "string", "$ref": "#/$defs/annotationText", "maxLength": 256 }] },
        "comment": { "anyOf": [{ "type": "null" }, { "type": "string", "$ref": "#/$defs/annotationText", "maxLength": 512 }] },
        "status": { "anyOf": [{ "type": "null" }, { "type": "string", "$ref": "#/$defs/annotationText", "maxLength": 64 }] },
        "unread": { "type": "boolean" },
        "pr": { "anyOf": [{ "type": "null" }, { "type": "string", "$ref": "#/$defs/annotationText", "maxLength": 1024 }] }
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "revision",
    "sessions"
  ],
  "properties": {
    "revision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sessions": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "instanceId",
          "generation",
          "startedAt",
          "lastSeenAt",
          "canView",
          "canControl",
          "inputRequired"
        ],
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 64,
            "pattern": "^[a-z0-9-]{8,64}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "title": {
            "type": "string",
            "maxLength": 256
          },
          "cwdLabel": {
            "type": "string",
            "maxLength": 256
          },
          "model": {
            "type": "string",
            "maxLength": 256
          },
          "startedAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          },
          "lastSeenAt": {
            "type": "string",
            "format": "date-time",
            "maxLength": 64
          },
          "canView": {
            "type": "boolean"
          },
          "canControl": {
            "type": "boolean"
          },
          "inputRequired": {
            "type": "boolean"
          },
          "busy": {
            "type": "boolean"
          },
          "ask": {
            "type": "object",
            "additionalProperties": false,
            "required": ["requestId", "since"],
            "properties": {
              "requestId": {
                "type": "string",
                "minLength": 16,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9_-]{16,128}$"
              },
              "since": {
                "type": "string",
                "format": "date-time",
                "maxLength": 64
              },
              "preview": {
                "type": "string",
                "maxLength": 256
              },
              "optionCount": {
                "type": "integer",
                "minimum": 1,
                "maximum": 128
              }
            }
          },
          "host": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "originalInstanceId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
          },
          "hostStatus": {
            "enum": ["live", "stale", "never"]
          },
          "available": {
            "type": "boolean"
          },
          "activity": { "$ref": "#/$defs/activity" },
          "workspace": { "$ref": "#/$defs/workspace" }
        },
        "dependentRequired": {
          "host": ["originalInstanceId", "hostStatus", "available"],
          "originalInstanceId": ["host", "hostStatus", "available"],
          "hostStatus": ["host", "originalInstanceId", "available"],
          "available": ["host", "originalInstanceId", "hostStatus"]
        },
        "if": { "properties": { "inputRequired": { "const": true } } },
        "then": { "properties": { "ask": true }, "required": ["ask"] },
        "else": { "properties": { "ask": false } },
        "allOf": [
          {
            "if": { "properties": { "host": true }, "required": ["host"] },
            "then": {
              "properties": {
                "instanceId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                "canView": { "const": false }
              }
            }
          },
          {
            "if": { "required": ["hostStatus"], "properties": { "hostStatus": { "const": "live" } } },
            "then": { "properties": { "available": { "const": true } } },
            "else": {
              "properties": { "available": { "const": false } }
            }
          },
          {
            "if": { "required": ["available"], "properties": { "available": { "const": false } } },
            "then": {
              "properties": { "canControl": { "const": false }, "busy": false }
            }
          }
        ]
      }
    },
    "hosts": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host", "status", "ageSeconds"],
        "properties": {
          "host": { "$ref": "#/properties/sessions/items/properties/host" },
          "status": { "$ref": "#/properties/sessions/items/properties/hostStatus" },
          "ageSeconds": {
            "anyOf": [
              { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
              { "type": "null" }
            ]
          },
          "error": {
            "type": "string",
            "maxLength": 512
          }
        },
        "if": { "properties": { "status": { "const": "never" } } },
        "then": { "properties": { "ageSeconds": { "type": "null" } } },
        "else": { "properties": { "ageSeconds": { "type": "integer" } } }
      }
    },
    "fleetStatus": {
      "enum": ["ok", "unreachable"]
    }
  }
}
